<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} level=%-5level logger=%logger{36} message=%msg%n</pattern>
    </encoder>
  </appender>

  <root level="WARN">
    <appender-ref ref="STDOUT" />
  </root>

  <!-- Unexpected failures are logged deliberately by some specs; they are expected noise. -->
  <logger name="io.github.castab.commerce.runtime.http" level="OFF" />

  <!-- Session lifecycle events; SessionManagerSpec asserts they never contain a token. -->
  <logger name="io.github.castab.commerce.runtime.session" level="INFO" />

  <!-- Service authentication events at DEBUG, so ServiceAccessTokensSpec can assert each event's level
       and that no event contains a secret or token. -->
  <logger name="io.github.castab.commerce.runtime.serviceauth" level="DEBUG" />
</configuration>
